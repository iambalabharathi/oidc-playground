# ---- Provider -----------------------------------------------------------------
# Issuer identifier; the discovery document is fetched from <ISSUER>/.well-known/openid-configuration
# itsme sandbox:    https://idp.e2e.itsme.services/v2
# itsme production: https://idp.prd.itsme.services/v2
ISSUER=https://idp.e2e.itsme.services/v2

# ---- Client -------------------------------------------------------------------
CLIENT_ID=YOUR_CLIENT_ID

# itsme accepts private_key_jwt (recommended) or client_secret_post.
# Leave CLIENT_AUTH empty to infer it: CLIENT_SECRET → client_secret_post, PRIVATE_KEY_FILE → private_key_jwt.
CLIENT_AUTH=
CLIENT_SECRET=
# JWK (JSON) or PEM (PKCS#8) private key for private_key_jwt and for decrypting JWE responses.
# The matching public JWKS is served at <BASE_URL>/.well-known/jwks.json — register that URL at the provider.
PRIVATE_KEY_FILE=
# Set to 1 when the provider is configured to encrypt the ID token / UserInfo for your client (needs an RSA PRIVATE_KEY_FILE).
DECRYPT_RESPONSES=0

# Default itsme service code; becomes the "service:<code>" scope (editable in the page).
SERVICE_CODE=YOUR_SERVICE_CODE

# ---- This app -----------------------------------------------------------------
# itsme only accepts https redirect URIs. Run `npm run cert` once, then keep the TLS lines below.
BASE_URL=https://localhost:8443
PORT=8443
# Redirect URI defaults to <BASE_URL>/callback; override only if you registered something else.
REDIRECT_URI=
TLS_KEY_FILE=certs/localhost-key.pem
TLS_CERT_FILE=certs/localhost-cert.pem

# Any long random string; sessions (tokens) are kept server-side in memory.
SESSION_SECRET=change-me
# Optional: PROVIDER_LABEL="itsme · sandbox (e2e)"   TRUST_PROXY=1 (behind a tunnel like ngrok)
