# Server settings only — the provider, client id, secret or private key are typed into the page.
# Copy to .env (loaded automatically) or export the variables.

# http://localhost:3000 by default; itsme only accepts https redirect URIs, so for itsme:
#   npm run cert   → creates certs/localhost-key.pem + certs/localhost-cert.pem
# and keep the three lines below → https://localhost:8443/callback
PORT=8443
TLS_KEY_FILE=certs/localhost-key.pem
TLS_CERT_FILE=certs/localhost-cert.pem

# Behind a tunnel / reverse proxy (ngrok etc.)
TRUST_PROXY=0
# Allow http:// issuers other than localhost (only for mocks on another machine)
ALLOW_INSECURE_ISSUER=0
# Seconds a provider's discovery document is cached in memory
DISCOVERY_CACHE_SECONDS=300
