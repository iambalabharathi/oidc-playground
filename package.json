{
  "name": "oidc-playground",
  "version": "0.1.0",
  "description": "Stateless OpenID Connect playground: fill in provider + client, pick claims, authorize, inspect the ID token and UserInfo.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node -r dotenv/config server/index.js",
    "mock-op": "node tools/mock-op.js",
